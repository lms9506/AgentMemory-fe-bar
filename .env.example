# Copy to .env and fill in — this is the SINGLE source of truth for deployment.
#   cp .env.example .env
#
# scripts/deploy_bundle.sh reads these, feeds them to the bundle, and writes the
# provisioned ids back here after deploy. You only set the values in the first two
# sections by hand.

# ── Workspace auth ────────────────────────────────────────────────────────────
# Log in first:  databricks auth login --profile <your-profile>
# Then put that profile name here. DATABRICKS_HOST is only needed to run the app
# locally (`uv run agent-memory-app`); deploys use the profile's host.
DATABRICKS_PROFILE=
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# ── Unity Catalog ─────────────────────────────────────────────────────────────
# The catalog must already exist and you need CREATE on the schema (the bundle
# creates the schema's Volume + the Delta table; 00_setup creates the rest).
UC_CATALOG=
UC_SCHEMA=wealth_advisor

# ── Optional overrides (sane defaults apply if left blank) ────────────────────
# VOLUME_NAME=dossier_raw
# FM_API_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# FM_API_EMBEDDING_ENDPOINT=databricks-gte-large-en

# ── Provisioned by `bundle deploy` and written back here automatically ────────
# Do NOT set these by hand — the Lakebase instance and SQL warehouse are created
# by the bundle and their ids land here after scripts/deploy_bundle.sh runs.
# DATABRICKS_SQL_WAREHOUSE_ID=
# LAKEBASE_INSTANCE_NAME=
# LAKEBASE_URL=
# LAKEBASE_DATABASE=databricks_postgres

# Copy to .env and fill in. .env is gitignored.

# Databricks workspace
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# Option A: paste token (quotes required for JWT). Option B: leave empty and use CLI profile below.
DATABRICKS_TOKEN="your-token-here"
# Matches ~/.databrickscfg profile name; used when DATABRICKS_TOKEN is empty.
DATABRICKS_PROFILE=e2-demo-field-eng

# Lakebase (T8) — recommended: URL from Connect + project/branch/compute (auto-refresh)
LAKEBASE_URL=postgresql://you@ep-....database....cloud.databricks.com/databricks_postgres?sslmode=require
LAKEBASE_PROJECT=agent-memory
LAKEBASE_BRANCH=production
LAKEBASE_COMPUTE=primary
# Or one line instead: LAKEBASE_CREDENTIAL_ENDPOINT=projects/agent-memory/branches/production/endpoints/primary
# Provisioned tier only (skip CREDENTIAL_ENDPOINT): set instance name instead
# LAKEBASE_INSTANCE_NAME=your-instance-name
# Optional override if DB name differs from the path in LAKEBASE_URL
# LAKEBASE_DATABASE=agent_memory

# Unity Catalog target for Delta tables
UC_CATALOG=agent_memory_dev
UC_SCHEMA=wealth_advisor

# Foundation Model API
FM_API_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# Use bge-large-en if deployed; FEVM workspaces often expose gte-large-en instead (also 1024-d)
FM_API_EMBEDDING_ENDPOINT=databricks-gte-large-en

# MLflow
MLFLOW_EXPERIMENT_NAME=/Shared/agent-memory/dev

# Apps
DATABRICKS_APP_NAME=wealth-advisor

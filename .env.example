# Copy to .env and fill in. .env is gitignored.

# Databricks workspace
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# Option A: paste token (quotes required for JWT). Option B: leave empty and use CLI profile below.
DATABRICKS_TOKEN="your-token-here"
# Matches ~/.databrickscfg profile name; used when DATABRICKS_TOKEN is empty.
DATABRICKS_PROFILE=e2-demo-field-eng

# Lakebase instance
LAKEBASE_INSTANCE_NAME=agent-memory-dev
LAKEBASE_DATABASE=agent_memory
LAKEBASE_HOST=<auto-populated-by-DAB-or-set-manually>

# Unity Catalog target for Delta tables
UC_CATALOG=agent_memory_dev
UC_SCHEMA=wealth_advisor

# Foundation Model API
FM_API_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
FM_API_EMBEDDING_ENDPOINT=databricks-bge-large-en

# MLflow
MLFLOW_EXPERIMENT_NAME=/Shared/agent-memory/dev

# Apps
DATABRICKS_APP_NAME=wealth-advisor

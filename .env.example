# Copy to .env and set your values, then: databricks auth login --profile <your-profile>
# The bundle is workspace-agnostic — the CLI supplies host + identity from your auth,
# and it PROVISIONS its own Lakebase instance + SQL warehouse, so there are no ids to
# paste here. Only the catalog/schema (and optional overrides) are workspace inputs.

# CLI profile from `databricks auth login` — the deploy script uses it for host + identity.
DATABRICKS_PROFILE=your-profile

# Unity Catalog the bundle writes into (Delta profile table, UC Volume, grants).
UC_CATALOG=your_catalog
UC_SCHEMA=wealth_advisor
VOLUME_NAME=dossier_raw

# Foundation Model API endpoints (defaults shown — override only if needed).
FM_API_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
FM_API_EMBEDDING_ENDPOINT=databricks-gte-large-en

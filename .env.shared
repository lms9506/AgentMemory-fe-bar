# Shared team defaults for the FEVM dev workspace (no secrets).
# Setup: cp .env.shared .env
# then: databricks auth login --profile fevm-serverless-stable-2eacei

DATABRICKS_HOST=https://fevm-serverless-stable-2eacei.cloud.databricks.com
DATABRICKS_PROFILE=fevm-serverless-stable-2eacei

LAKEBASE_URL=postgresql://linus.meister%40databricks.com@ep-odd-term-d7j3href.database.eu-central-1.cloud.databricks.com/databricks_postgres?sslmode=require
LAKEBASE_PROJECT=agent-memory
LAKEBASE_BRANCH=production
LAKEBASE_COMPUTE=primary

# FEVM dev: use your workspace catalog (agent_memory_dev needs metastore CREATE_CATALOG)
UC_CATALOG=serverless_stable_2eacei_catalog
UC_SCHEMA=wealth_advisor
